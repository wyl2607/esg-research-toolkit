{
  "name": "frontend",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "gen:types": "bash ../scripts/gen-types.sh",
    "test:unit": "vitest run",
    "test:playwright": "playwright test --config=playwright.config.ts",
    "test:smoke": "playwright test --config=playwright.config.ts tests/smoke.spec.ts tests/workflow-gap-fill.spec.ts tests/trend-visualization.spec.ts tests/framework-versioning.spec.ts",
    "test:a11y": "playwright test --config=playwright.config.ts tests/a11y.spec.ts",
    "health:check": "node ./scripts/frontend-health-check.mjs",
    "health:check:ci": "node ./scripts/frontend-health-check.mjs --ci",
    "health:nginx": "node ../scripts/qa/nginx-spa-smoke.mjs"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.104.3",
    "class-variance-authority": "^0.7.1",
    "i18next": "^26.4.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.3",
    "react-i18next": "^17.0.18",
    "react-router-dom": "7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.1",
    "@playwright/test-runner": "^0.9.24",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "lighthouse": "^13.5.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "8.5.30",
    "js-yaml": "4.3.0",
    "minimatch@3": {
      "brace-expansion": "1.1.16"
    },
    "minimatch@5": {
      "brace-expansion": "2.1.2"
    },
    "minimatch@9": {
      "brace-expansion": "2.1.2"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.8"
    },
    "lighthouse": {
      "ws": "7.5.13"
    }
  }
}
