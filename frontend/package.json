{
  "name": "frontend",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "gen:types": "bash ../scripts/gen-types.sh",
    "test:unit": "vitest run",
    "test:playwright": "playwright test --config=playwright.config.ts",
    "test:smoke": "playwright test --config=playwright.config.ts tests/smoke.spec.ts tests/workflow-gap-fill.spec.ts tests/trend-visualization.spec.ts tests/framework-versioning.spec.ts",
    "test:a11y": "playwright test --config=playwright.config.ts tests/a11y.spec.ts",
    "health:check": "node ./scripts/frontend-health-check.mjs",
    "health:check:ci": "node ./scripts/frontend-health-check.mjs --ci",
    "health:nginx": "node ../scripts/qa/nginx-spa-smoke.mjs"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.106.1",
    "class-variance-authority": "^0.7.1",
    "i18next": "^26.7.1",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-i18next": "^17.1.12",
    "react-router-dom": "7.18.5",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@playwright/test-runner": "^0.9.24",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "lighthouse": "^13.6.0",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": "8.5.32",
    "js-yaml": "4.3.2",
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@5": {
      "brace-expansion": "2.1.7"
    },
    "minimatch@9": {
      "brace-expansion": "2.1.7"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.12"
    },
    "lighthouse": {
      "ws": "7.5.13"
    }
  }
}
