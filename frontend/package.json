{
  "name": "frontend",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "gen:types": "bash ../scripts/gen-types.sh",
    "test:unit": "vitest run",
    "test:playwright": "playwright test --config=playwright.config.ts",
    "test:smoke": "playwright test --config=playwright.config.ts tests/smoke.spec.ts tests/workflow-gap-fill.spec.ts tests/trend-visualization.spec.ts tests/framework-versioning.spec.ts",
    "test:a11y": "playwright test --config=playwright.config.ts tests/a11y.spec.ts",
    "health:check": "node ./scripts/frontend-health-check.mjs",
    "health:check:ci": "node ./scripts/frontend-health-check.mjs --ci"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^19.1.1",
    "react-i18next": "^17.0.11",
    "react-router-dom": "7.18.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@playwright/test-runner": "^0.9.24",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "lighthouse": "^13.4.1",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.26",
    "js-yaml": "4.3.0",
    "minimatch@3": {
      "brace-expansion": "1.1.16"
    },
    "minimatch@5": {
      "brace-expansion": "2.1.2"
    },
    "minimatch@9": {
      "brace-expansion": "2.1.2"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.8"
    },
    "lighthouse": {
      "ws": "7.5.13"
    }
  }
}
